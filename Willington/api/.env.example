PORT=3000
DATABASE_URL="postgresql://usuario:password@localhost:5432/control_acceso?schema=public"

# Umbral de similitud (distancia coseno) para considerar match biometrico. Mas bajo = mas estricto.
FACE_MATCH_THRESHOLD=0.35

# Ventana de tolerancia del TOTP, en pasos de 20s (1 = +-20s ademas del paso actual)
TOTP_WINDOW_STEPS=1
