{
  "expo": {
    "name": "PGD Visitante",
    "slug": "app-visitante",
    "scheme": "pgdvisitante",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.com.pgd.visitante"
    },
    "android": {
      "package": "co.com.pgd.visitante",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "$(PRODUCT_NAME) necesita la cámara para tomarte una foto al registrarte.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "$(PRODUCT_NAME) usa Face ID para confirmar que eres tú."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f67e427-8788-4420-b068-93ca793dce87"
      }
    },
    "owner": "daniela-barrios"
  }
}
